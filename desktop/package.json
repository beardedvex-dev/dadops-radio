{
  "name": "dadops-radio-desktop",
  "productName": "DAD Ops Radio",
  "version": "0.1.0",
  "description": "DAD Ops Radio for Windows: talk keys that work in-game, plus an overlay",
  "author": "DAD Ops",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.dadops.radio",
    "productName": "DAD Ops Radio",
    "artifactName": "DAD-Ops-Radio-Setup-${version}.${ext}",
    "files": ["main.js", "keys.js", "preload.js", "overlay-preload.js", "overlay.html", "overlay.js", "config.json", "build/icon.png"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DAD Ops Radio",
      "runAfterFinish": true
    },
    "publish": [{ "provider": "github", "owner": "beardedvex-dev", "repo": "DadOps-Radio", "releaseType": "release" }]
  }
}
