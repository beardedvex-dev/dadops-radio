{
  "name": "dadops-radio-desktop",
  "productName": "DAD Ops Radio",
  "version": "0.5.0",
  "description": "Dad Net for Windows: talk keys that work in-game, the overlay and the Battle Board",
  "author": "DAD Ops",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.dadops.radio",
    "productName": "DAD Ops Radio",
    "artifactName": "Dad-Net-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "keys.js",
      "preload.js",
      "overlay-preload.js",
      "overlay.html",
      "overlay.js",
      "config.json",
      "shell.html",
      "shell.js",
      "shell-preload.js",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dad Net",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "beardedvex-dev",
        "repo": "DadOps-Radio",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}
